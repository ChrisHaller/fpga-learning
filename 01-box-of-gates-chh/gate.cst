// Tang Nano 20K: the two push buttons and the first LED.
IO_LOC "btn1" 88;
IO_PORT "btn1" IO_TYPE=LVCMOS33;
IO_LOC "btn2" 87;
IO_PORT "btn2" IO_TYPE=LVCMOS33;
IO_LOC "led1" 15;
IO_LOC "led2" 16;
IO_LOC "led3" 17;
IO_PORT "led1" DRIVE=8 IO_TYPE=LVCMOS18;
IO_PORT "led2" DRIVE=8 IO_TYPE=LVCMOS18;
IO_PORT "led3" DRIVE=8 IO_TYPE=LVCMOS18;
